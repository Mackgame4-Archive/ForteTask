{
  "name": "fortetask-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migration:create": "prisma migrate dev",
    "db:migration:up": "prisma db push --accept-data-loss && prisma db seed",
    "db:migration:down": "prisma migrate reset --force",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
