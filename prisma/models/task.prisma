model Task {
  id Int @id @default(autoincrement())
  tenantId Int? @map("tenant_id")
  columnId Int? @map("column_id")
  createdById Int? @map("created_by_id")
  title String @db.VarChar(255)
  description String?
  completed Boolean @default(false)
  position Int @default(0)
  startDate DateTime? @map("start_date") @db.Timestamptz
  dueDate DateTime? @map("due_date") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  column BoardColumn? @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdBy User? @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  labels TaskLabel[]
  subTasks SubTask[]
  assignees TaskAssignee[]
  customFieldValues TaskCustomFieldValue[]
  attachments TaskAttachment[]
  comments TaskComment[]
  activities TaskActivity[]

  @@index([tenantId])
  @@index([columnId])
  @@index([createdById])
  @@index([startDate])
  @@index([dueDate])
  @@index([completedAt])
  @@map("task")
}

model TaskComment {
  id Int @id @default(autoincrement())
  taskId Int @map("task_id")
  authorId Int? @map("author_id")
  body String @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([authorId])
  @@map("task_comment")
}

model TaskActivity {
  id Int @id @default(autoincrement())
  taskId Int @map("task_id")
  actorId Int? @map("actor_id")
  type String @db.VarChar(80)
  message String @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([actorId])
  @@map("task_activity")
}

model TaskAttachment {
  id Int @id @default(autoincrement())
  taskId Int @map("task_id")
  uploadedById Int? @map("uploaded_by_id")
  bucket String @db.VarChar(120)
  objectKey String @map("object_key") @db.VarChar(500)
  fileName String @map("file_name") @db.VarChar(255)
  contentType String @map("content_type") @db.VarChar(255)
  size Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("TaskAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([uploadedById])
  @@map("task_attachment")
}

model TaskCustomFieldValue {
  taskId Int @map("task_id")
  customFieldId Int @map("custom_field_id")
  stringValue String? @map("string_value") @db.VarChar(255)
  integerValue Int? @map("integer_value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customField BoardCustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@id([taskId, customFieldId])
  @@index([customFieldId])
  @@map("task_custom_field_value")
}

model TaskAssignee {
  taskId Int @map("task_id")
  userId Int @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignee")
}

model TaskLabel {
  taskId Int @map("task_id")
  boardLabelId Int @map("board_label_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label BoardLabel @relation(fields: [boardLabelId], references: [id], onDelete: Cascade)

  @@id([taskId, boardLabelId])
  @@index([boardLabelId])
  @@map("task_board_label")
}

model SubTask {
  id Int @id @default(autoincrement())
  taskId Int @map("task_id")
  title String @db.VarChar(255)
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("sub_task")
}
