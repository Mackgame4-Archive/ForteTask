model RedicomSale {
  id Int @id @default(autoincrement())
  tenantId Int? @map("tenant_id")
  encomendaId Int @map("encomenda_id")
  encomendaRef String? @map("encomenda_ref") @db.VarChar(80)
  encomendaEstado String? @map("encomenda_estado") @db.VarChar(80)
  tipo String? @db.VarChar(80)
  canal String? @db.VarChar(80)
  isaLoja String? @map("isa_loja") @db.VarChar(120)
  faturaData DateTime? @map("fatura_data") @db.Date
  fatura String? @db.VarChar(80)
  productSku String? @map("product_sku") @db.VarChar(120)
  productId Int? @map("product_id")
  quantidadeUni Decimal? @map("quantidade_uni") @db.Decimal(12, 3)
  produtoValor Decimal? @map("produto_valor") @db.Decimal(12, 2)
  produtoValorRiscado Decimal? @map("produto_valor_riscado") @db.Decimal(12, 2)
  familiaNome String? @map("familia_nome") @db.VarChar(120)
  subFamiliaNome String? @map("sub_familia_nome") @db.VarChar(120)
  marca String? @db.VarChar(120)
  estacao String? @db.VarChar(80)
  genero String? @db.VarChar(80)
  categoria String? @db.VarChar(120)
  subCategoria String? @map("sub_categoria") @db.VarChar(120)
  faixaEtaria String? @map("faixa_etaria") @db.VarChar(80)
  encomendaData DateTime? @map("encomenda_data") @db.Date
  encomendaDataHora DateTime? @map("encomenda_data_hora") @db.Timestamptz
  encomendaMoeda String? @map("encomenda_moeda") @db.VarChar(8)
  encomendaCambio Decimal? @map("encomenda_cambio") @db.Decimal(12, 6)
  encomendaQuantidade Decimal? @map("encomenda_quantidade") @db.Decimal(12, 3)
  encomendaValorTotal Decimal? @map("encomenda_valor_total") @db.Decimal(12, 2)
  encomendaPortesValor Decimal? @map("encomenda_portes_valor") @db.Decimal(12, 2)
  metodoEntrega String? @map("metodo_entrega") @db.VarChar(120)
  metodoEntregaId Int? @map("metodo_entrega_id")
  servicoTransportadora String? @map("servico_transportadora") @db.VarChar(120)
  metodoPagamento String? @map("metodo_pagamento") @db.VarChar(120)
  encomendaPaga Boolean? @map("encomenda_paga")
  cupaoId Int? @map("cupao_id")
  cupao String? @db.VarChar(120)
  desconto Decimal? @db.Decimal(12, 2)
  servicoPagamento String? @map("servico_pagamento") @db.VarChar(120)
  clienteId Int? @map("cliente_id")
  clienteNome String? @map("cliente_nome") @db.VarChar(160)
  clienteEmail String? @map("cliente_email") @db.VarChar(255)
  clienteCodigoErp String? @map("cliente_codigo_erp") @db.VarChar(80)
  clienteDataRegisto DateTime? @map("cliente_data_registo") @db.Date
  clienteRegistado Boolean? @map("cliente_registado")
  codigoPostal String? @map("codigo_postal") @db.VarChar(40)
  clientePais String? @map("cliente_pais") @db.VarChar(80)
  pickupNome String? @map("pickup_nome") @db.VarChar(160)
  encomendaArmazemId Int? @map("encomenda_armazem_id")
  encomendaArmazem String? @map("encomenda_armazem") @db.VarChar(120)
  encomendaPais String? @map("encomenda_pais") @db.VarChar(80)
  encomendaMercado String? @map("encomenda_mercado") @db.VarChar(80)
  paraOferecer Boolean? @map("para_oferecer")
  mensagemOferta String? @map("mensagem_oferta") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, encomendaId, fatura, productId, productSku])
  @@index([tenantId, encomendaData])
  @@index([encomendaData])
  @@index([genero])
  @@index([marca])
  @@index([categoria])
  @@map("redicom_sale")
}
