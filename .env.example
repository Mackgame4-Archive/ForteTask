### App Related ###
DATABASE_URL="postgresql://fortetask:fortetask_password@localhost:5432/fortetask?schema=public"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_CHAT_SOCKET_URL=
USE_HTTPS=false
APP_URL=localhost

### Docker Related ###
APP_PORT=3000

### Postgres Related ###
POSTGRES_DB=fortetask
POSTGRES_USER=fortetask
POSTGRES_PASSWORD=fortetask_password
POSTGRES_PORT=5432

### MinIO / S3 Related ###
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=fortetask
MINIO_ROOT_PASSWORD=fortetask_minio_password
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="fortetask"
S3_ACCESS_KEY_ID="fortetask"
S3_SECRET_ACCESS_KEY="fortetask_minio_password"
S3_FORCE_PATH_STYLE="true"

### Email / Password Reset Related ###
# In development, reset links are logged to the server console when these are not configured.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=

### Seed Root User Related ###
ROOT_USER_EMAIL="root@root.com"
ROOT_USER_PASSWORD="root"
ROOT_USER_NAME="Root"
