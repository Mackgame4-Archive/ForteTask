POSTGRES_DB=fortetask
POSTGRES_USER=fortetask
POSTGRES_PASSWORD=fortetask_password
POSTGRES_PORT=5432
APP_PORT=3000

DATABASE_URL="postgresql://fortetask:fortetask_password@localhost:5432/fortetask?schema=public"
USE_HTTPS= # Set to true if you want to use HTTPS, false for local development or empty to auto-detect based on APP_URL
APP_URL=localhost # Change this to your actual domain/sub-domain when deploying

# Optional password reset email delivery via Resend. In development, reset links
# are logged to the server console when these are not configured.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=

ROOT_USER_EMAIL="root@root.com"
ROOT_USER_PASSWORD="root"
ROOT_USER_NAME="Root"
